<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottom_load_more"
    android:layout_width="match_parent"
    android:layout_height="@dimen/one_list_refresh_height">

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="@dimen/one_list_refresh_progress_size"
        android:layout_height="@dimen/one_list_refresh_progress_size"
        android:layout_gravity="center"
        android:indeterminateBehavior="repeat"
        android:indeterminateDuration="500"
        android:indeterminateOnly="true"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tips_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/one_list_more_scrolling_tips" />

</FrameLayout>
